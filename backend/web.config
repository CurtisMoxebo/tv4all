<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Register iisnode module for compiled entry point -->
    <handlers>
      <add name="iisnode" path="dist/index.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Allow access to iisnode debugger / log inspector -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^dist/index.js[/](debug)?(\/)?$" />
        </rule>

        <!-- Route all traffic into the Node.js backend -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="dist/index.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Configure iisnode runtime parameters -->
    <iisnode
      nodeProcessCommandLine="&quot;%ProgramFiles%\nodejs\node.exe&quot;"
      watchedFiles="web.config;dist\index.js;.env"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="true"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
    />

    <!-- Disable response buffering so live video chunks stream immediately -->
    <serverRuntime responseBufferLimit="0" />

    <!-- Security: Block direct HTTP downloads of sensitive files -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="src" />
          <add segment="tests" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>

